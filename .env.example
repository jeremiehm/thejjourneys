# Remplacez par les valeurs de votre projet Supabase (Dashboard → Settings → API).
# L'URL doit être de la forme https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Origin public du site (sitemap, robots, metadata, Open Graph).
# Local: http://localhost:3000
# Production (Vercel): https://www.dot-onthemap.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assistant IA (serveur uniquement — ne pas exposer côté client)
OPENAI_API_KEY=sk-...
# Optionnel : gpt-4o (défaut), gpt-4o-mini, etc.
# OPENAI_MODEL=gpt-4o
